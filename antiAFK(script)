import keyboard
import time

while True:
    keyboard.press("down")
    keyboard.release("down")
    time.sleep(0.5)
    keyboard.press("up")
    keyboard.release("up")
    time.sleep(0.5)
    keyboard.press("left")
    keyboard.release("left")
    time.sleep(0.5)
    keyboard.press("right")
    keyboard.release("right")
    time.sleep(0.5)
    keyboard.press("space")
    keyboard.release("space")   
    
